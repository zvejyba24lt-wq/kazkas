<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kimba" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/amber</item>
    </style>

    <style name="Theme.Kimba.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/night</item>
        <item name="postSplashScreenTheme">@style/Theme.Kimba</item>
    </style>
</resources>
